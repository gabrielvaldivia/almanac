	<string>Almanac uses contact names and birthdays so you can choose which birthdays to add to your calendar.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.almanac.reminders</string></array>
	<key>UIBackgroundModes</key><array><string>fetch</string></array>
